<Page
    x:Class="DroidDeckXbox.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#10131A">

    <Grid Padding="50">
        <StackPanel VerticalAlignment="Center" Spacing="24">

            <TextBlock
                Text="DROIDDECK"
                FontSize="42"
                FontWeight="Bold"
                Foreground="White"/>

            <TextBlock
                Text="Xbox Edition"
                FontSize="22"
                Foreground="#8FA3C0"/>

            <TextBlock
                Text="Welcome to DroidDeck for Xbox"
                FontSize="18"
                Foreground="White"/>

            <Button
                Content="Library"
                Width="300"
                HorizontalAlignment="Left"
                FontSize="22"/>

            <Button
                Content="Settings"
                Width="300"
                HorizontalAlignment="Left"
                FontSize="22"/>

            <TextBlock
                Text="Experimental Xbox Port"
                Foreground="#8FA3C0"/>

        </StackPanel>
    </Grid>
</Page>
